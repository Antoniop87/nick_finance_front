{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/nick-finance/browser",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://nick-finance-api.onrender.com/:path*" },
    { "source": "/((?!api/)[^.]*)", "destination": "/index.html" }
  ]
}
